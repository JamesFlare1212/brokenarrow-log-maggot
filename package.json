{
  "name": "broken-arrow-log-assistant",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "Broken Arrow Log Assistant — local match analysis, decks and recordings",
  "main": "apps/desktop/dist/main.cjs",
  "author": "Zola",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "format": "prettier --write apps packages tests scripts docs *.json *.yaml .github/**/*.yml *.md",
    "format:check": "prettier --check apps packages tests scripts docs *.json *.yaml .github/**/*.yml *.md",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @ba/server build && vite --config apps/web/vite.config.ts --mode fixtures",
    "data:import": "pnpm --filter @ba/server build && node scripts/import-real-data.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @ba/web build && pnpm --filter @ba/server build && pnpm --filter @ba/desktop build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "smoke:real": "pnpm build && node scripts/smoke.mjs --real",
    "smoke:packaged": "node scripts/smoke.mjs \"dist/win-unpacked/断箭蛐工具.exe\"",
    "dist": "pnpm build && node scripts/prepare-icon.mjs && electron-builder --win --publish never",
    "pack:desktop": "pnpm build && node scripts/prepare-icon.mjs && electron-builder --dir --publish never"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "lucide-react": "1.57.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "zod": "4.6.7"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "JamesFlare1212",
      "repo": "brokenarrow-log-maggot",
      "releaseType": "release"
    },
    "appId": "com.zola.brokenarrow.maggot",
    "productName": "断箭蛐工具",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "apps/desktop/dist/**",
      "apps/web/dist/**",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "BrokenArrow-Setup-${version}-${arch}.${ext}",
      "differentialPackage": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "断箭蛐工具"
    },
    "portable": {
      "artifactName": "BrokenArrow-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
